APP_NAME=WorkFlow360
APP_ENV=development            # development | production
DEBUG=false

# XAMPP MySQL defaults: user root, empty password. Change if you set a root password.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workflow360_db
DB_USER=root
DB_PASSWORD=

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma separated browser origins allowed by CORS (the React dev server).
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
